{
  "nodeModulesDir": "auto",
  "tasks": {
    "web:dev": "vite",
    "web:build": "vite build",
    "web:check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "tauri": "tauri"
  },
  "imports": {
    "@sveltejs/vite-plugin-svelte": "npm:@sveltejs/vite-plugin-svelte@^7.3.1",
    "@tauri-apps/api": "npm:@tauri-apps/api@^2.11.0",
    "@tauri-apps/api/": "npm:/@tauri-apps/api@^2.11.0/",
    "@tauri-apps/cli": "npm:@tauri-apps/cli@^2.11.0",
    "svelte": "npm:svelte@^5.57.1",
    "svelte/": "npm:/svelte@^5.57.1/",
    "svelte-check": "npm:svelte-check@^4.7.6",
    "typescript": "npm:typescript@^6.0.3",
    "vite": "npm:vite@^8.3.1"
  },
  "fmt": {
    "lineWidth": 110,
    "include": [
      "src/",
      "tests/",
      "vite.config.ts",
      "svelte.config.js",
      "index.html",
      "deno.json",
      "tsconfig.json"
    ]
  },
  "lint": {
    "include": [
      "src/",
      "tests/",
      "vite.config.ts"
    ]
  }
}
